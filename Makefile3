# Linux Makefile to build NOVAS C library and test applications
# using solsys3.c

OBJ_DIR := ./obj
LIB_DIR := ./lib
APP_DIR := ./bin
BUILD_DIRS = $(OBJ_DIR) $(LIB_DIR) $(APP_DIR)

CC  := gcc
LD  := ld
AR  := ar
STRIP := strip

CFLAGS += -c -O2 -Wall -W -MMD -MP -MF $(subst .o,.d,$@)

COMPILE_C=@$(CC) -o $@ $(CFLAGS) $<
LINK=$(CC) $(LDFLAGS) -o $@ $^ -lm
MKLIB=@$(AR) -cr $@ $^


OBJS = $(patsubst %.c, $(OBJ_DIR)/%.o, $(SOURCES))
BUILD_TARGET_LIB = $(patsubst %, $(LIB_DIR)/%.a, $(TARGET_LIB))
DEPS = $(patsubst %.o, %.d, $(OBJS) $(TEST_OBJS))

TARGET_LIB := libnovas

SOURCES := \
	novas.c \
	novascon.c \
	nutation.c \
	solsys3.c \
	readeph0.c


all: $(BUILD_DIRS) $(BUILD_TARGET_LIB) check

# Builds a test executable to check library.
check: $(APP_DIR)/checkout-stars
	$< > checkout-stars-local.txt
	@echo Comparing output.
	diff -w checkout-stars-usno.txt checkout-stars-local.txt

$(OBJ_DIR) $(LIB_DIR) $(APP_DIR):
	mkdir -p $@

$(OBJ_DIR)/%.o : %.c Makefile
	@echo $@
	$(COMPILE_C)

$(BUILD_TARGET_LIB): $(OBJS)
	@echo Updating library $@
	$(MKLIB)


$(APP_DIR)/checkout-stars: $(OBJ_DIR)/checkout-stars.o $(BUILD_TARGET_LIB)
	@echo $@
	$(LINK)


clean:
	@rm -rf $(LIB_DIR)/ $(OBJ_DIR)/ $(APP_DIR)/

realclean: clean
	@rm JPLEPH

-include $(DEPS)




